{
  "manifest_version": 3,
  "name": "Cloud Booking Processor",
  "version": "1.2",
  "key": "",
  "permissions": [
    "cookies",
    "webRequest",
    "tabs",
    "windows"
  ],
  "host_permissions": [
    "*://*.irctc.co.in/*",
    "http://localhost:5005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.irctc.co.in/*"],
      "js": ["panel.js"],
      "run_at": "document_idle"
    }
  ]
}